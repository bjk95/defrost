# Defrost dev-mode scratch directory (see `defrost exec --dev`)
.defrost-dev/

# Build artefacts. Anchor with a leading slash so the patterns only
# match files at the repo root — bare 'defrost' or 'defrost-ci' would
# also match the cmd/defrost/ and cmd/defrost-ci/ source directories,
# silently skipping main.go and breaking CI builds.
/defrost
/defrost.exe
/defrost-ci
/defrost-ci.exe

# Web tooling
web/node_modules/

# Brainstorm session content (Visual Companion)
.superpowers/

# Superpowers plans + specs are agent-session artefacts, not maintained
# documentation. Already-tracked files stay; new ones don't get added.
docs/superpowers/

# OS noise
.DS_Store

# Python bytecode (e.g. examples/inspect/__pycache__)
__pycache__/
*.pyc
